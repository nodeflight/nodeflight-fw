|{ cwd, include, pb, ... } { lib, ... }|
# The FreeRTOS kernel, with the port of the core of the target. Its
# configuration, FreeRTOSConfig.h, is the platform's.
let
    port = |dir| lib.lang.c.mod {
        src = ["${cwd}/freertos/portable/${dir}/port.c",];
        inc = ["${cwd}/freertos/portable/${dir}",];
    };
in
lib.merge [
    (lib.lang.c.mod {
        src = [
            "${cwd}/freertos/croutine.c",
            "${cwd}/freertos/event_groups.c",
            "${cwd}/freertos/list.c",
            "${cwd}/freertos/queue.c",
            "${cwd}/freertos/stream_buffer.c",
            "${cwd}/freertos/tasks.c",
            "${cwd}/freertos/timers.c",
        ];
        inc = ["${cwd}/freertos/include",];
    }),
    # Cortex-M4 with FPU
    (lib.gate (|self| pb.matches "stm32f4*" self.config.variant) (port "GCC/ARM_CM4F")),
    # Cortex-M7 revision r0p1, which also suits later revisions
    (lib.gate (|self| pb.matches "stm32f7*" self.config.variant) (port "GCC/ARM_CM7/r0p1")),
]