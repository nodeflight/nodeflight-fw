
include vendor/stm32/stm32f405xg.mk
include vendor/freertos.mk
include vendor/fatfs.mk
include vendor/tinyprintf.mk
include make/nodeflight-stm32f4xx.mk

CFLAGS += \
	-DSTM32F405xx

LDFLAGS += \
	-Wl,-Llinker \
	-TSTM32F405xG.ld

INC += \
	src/integration/fatfs \
	src/platform/stm32 \
	src/platform/stm32f4xx \
	src

CFLAGS += \
	-DUSE_FULL_LL_DRIVER \
	-DHSE_VALUE=8000000

include $(CBE)/lang/gcc/appl.mk